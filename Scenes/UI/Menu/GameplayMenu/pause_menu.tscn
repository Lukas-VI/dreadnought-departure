[gd_scene format=3 uid="uid://pause_menu"]

[ext_resource type="Script" path="res://Scripts/UI/Menu/PauseMenuController.cs" id="1_pause"]

[node name="PauseMenuController" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
process_mode = 3
script = ExtResource("1_pause")

[node name="Overlay" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.5)
mouse_filter = 2

[node name="CenterContainer" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="CenterContainer"]
layout_mode = 2
size_flags_vertical = 0
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
horizontal_alignment = 1
text = "暂停"

[node name="BtnResume" type="Button" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(240, 50)
theme_override_font_sizes/font_size = 22
text = "继续"

[node name="BtnRetry" type="Button" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(240, 50)
theme_override_font_sizes/font_size = 22
text = "重来"

[node name="BtnMainMenu" type="Button" parent="CenterContainer/VBoxContainer"]
layout_mode = 2
custom_minimum_size = Vector2(240, 50)
theme_override_font_sizes/font_size = 22
text = "返回主菜单"

[connection signal="pressed" from="CenterContainer/VBoxContainer/BtnResume" to="." method="_OnResumePressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/BtnRetry" to="." method="_OnRetryPressed"]
[connection signal="pressed" from="CenterContainer/VBoxContainer/BtnMainMenu" to="." method="_OnMainMenuPressed"]
